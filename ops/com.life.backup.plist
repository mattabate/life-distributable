<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly 03:30 backup. A template: load it AFTER ops/secrets/restic.env
     exists and `ops/backup.sh init` has been run once, with
       ops/hub.sh install-backup
     which renders __HOME__ into ~/Library/LaunchAgents and bootstraps it. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.life.backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/life/ops/backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/life/ops/logs/backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/life/ops/logs/backup.log</string>
</dict>
</plist>
