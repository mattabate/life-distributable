<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the Mac from idle-sleeping while on AC power so the hub and tmux'd
     Claude sessions stay reachable. -s = only while plugged in; on battery
     the Mac sleeps normally. No sudo needed (unlike pmset). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.life.keepawake</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/caffeinate</string><string>-s</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
</dict>
</plist>
