<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Tailscale certs last ~90 days. Re-mint on the 1st of each month at 04:00
     and restart the hub so it picks the new one up. A template: `ops/hub.sh
     install` renders __HOME__ into ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.life.renewcert</string>
  <key>ProgramArguments</key>
  <array><string>__HOME__/life/ops/renew-cert.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>4</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/life/ops/logs/renew-cert.log</string>
  <key>StandardErrorPath</key><string>__HOME__/life/ops/logs/renew-cert.log</string>
</dict>
</plist>
