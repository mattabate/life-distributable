# `ops/py.sh setup.py backup --bucket <name>` copies this to
# ops/secrets/restic.env (git-ignored) with the bucket filled in; then
# `ops/b2-mint-keys.sh` (run by you, in Terminal) fills the key and the
# passphrase. ops/backup.sh sources it.
#
# Any restic backend works — change RESTIC_REPOSITORY and the credential
# variables it needs.
export B2_ACCOUNT_ID="<keyID>"
export B2_ACCOUNT_KEY="<applicationKey>"
export RESTIC_REPOSITORY="b2:<bucket-name>:life"

# The client-side encryption password. The storage provider only ever sees
# ciphertext. CRITICAL: keep a copy in Apple Passwords — if this is lost,
# every backup is permanently unreadable.
export RESTIC_PASSWORD="<long-random-passphrase>"
