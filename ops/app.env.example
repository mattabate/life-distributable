# Setup copies this to ops/app.env (git-ignored). Bundle id, app group and
# team id live in app/local.xcconfig (see app/Identity.xcconfig), not here.
#
# The iPhone ops/install-phone.sh installs to: its CoreDevice identifier, from
#   xcrun devicectl list devices   (the "Identifier" column)
LIFE_DEVICE_ID=00000000-0000-0000-0000-000000000000
