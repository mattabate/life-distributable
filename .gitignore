# Personal data and machine config — written at setup, never committed.
# Anchored: an unanchored `data/` also swallows any nested data dir (a
# package's src/data would never be committed).
/data/
ops/secrets/
ops/hub.json
ops/app.env
ops/logs/
ops/bin/
projects/
app/local.xcconfig

# Generated.
app/build/
app/build-mac/
app/Life.xcodeproj/
*.xcresult
__pycache__/
.DS_Store
